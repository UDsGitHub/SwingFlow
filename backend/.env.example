# ── Clerk (authentication) ───────────────────────────────────
# Get from clerk.com → your app → API Keys
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Supabase (database only) ──────────────────────────────────
# Find these in your Supabase project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # keep this secret

# ── Data provider ─────────────────────────────────────────────
# mock | alpaca | polygon  (defaults to alpaca when unset)
DATA_PROVIDER=mock

# Alpaca — https://alpaca.markets → Paper account → API Keys (key ID starts with PK)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# sip (full consolidated volume, free plan = 15-min delayed) | iex (real-time, partial volume)
ALPACA_DATA_FEED=sip
# Used only for ticker search (assets list)
ALPACA_TRADING_URL=https://paper-api.alpaca.markets/v2

# Polygon/Massive (paid, optional) — https://polygon.io
POLYGON_API_KEY=

# ── Web Push (push notifications) ────────────────────────────
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# ── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Comma-separated browser origins allowed to call the API (scheme + host + port, no path).
# Production: include your deployed frontend URL(s), e.g.
# CORS_ORIGINS=https://your-frontend.up.railway.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Strategies that generate setups (comma-separated). Only REVERSAL passed out-of-sample
# validation; TREND_PULLBACK and BREAKOUT can be re-enabled for experimentation.
ENABLED_STRATEGIES=REVERSAL

# Cron: every 10 min, Mon–Fri, 9am–4pm ET
SCAN_SCHEDULE=*/10 9-16 * * 1-5

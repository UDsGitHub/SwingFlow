# Data provider: mock | finnhub | polygon
DATA_PROVIDER=mock

# Finnhub (free tier) - get at finnhub.io
FINNHUB_API_KEY=

# Polygon.io (paid) - get at polygon.io
POLYGON_API_KEY=

# Web Push VAPID keys - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BEeNSmH7xLpHkQHY8Lkr9QJzVqmTY5z9Sp8BzJY6XrE7oQbvZJf9pTqNx4V3rK2mL8nE0WdZjF1cSjK4mYc
VAPID_PRIVATE_KEY=placeholder_generate_with_web_push_cli
VAPID_EMAIL=mailto:you@example.com

# Server
PORT=3001
NODE_ENV=development

# Strategy engine schedule (cron expression - every 10 minutes during market hours)
SCAN_SCHEDULE=*/10 9-16 * * 1-5

# Account settings defaults
DEFAULT_ACCOUNT_SIZE=5000
DEFAULT_DAILY_GOAL=100
DEFAULT_RISK_PERCENT=1.5
